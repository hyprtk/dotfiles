+    Timer {
+        id: fallbackStartTimer
+        interval: 150
+        repeat: false
+        onTriggered: {
+            Quickshell.execDetached(["sh", "-c", root._fallbackCmd]);
+            fallbackQuitTimer.start();
+        }
+    }
+
+    Timer {
+        id: fallbackQuitTimer
+        interval: 400
+        repeat: false
+        onTriggered: Qt.quit()
+    }
